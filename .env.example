# Copy to .env and adjust as needed. All variables are optional; every
# setting has a default (see src/dlm/config.py).

# Python logging level: DEBUG | INFO | WARNING | ERROR
DLM_LOG_LEVEL=INFO

# Default global random seed (overridable per-command / per-experiment)
DLM_SEED=42

# Override any data/cache/results/instances/scenarios directory if you want
# them outside the repo, e.g. for a shared cache on a lab machine:
# DLM_CACHE_DIR=/var/cache/dlm
